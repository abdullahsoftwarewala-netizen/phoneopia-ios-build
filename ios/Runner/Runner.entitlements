<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- APNs environment for Firebase Cloud Messaging.
	     Xcode's automatic signing switches this to "production" when you
	     Archive for the App Store. Keep "development" for debug/testing. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
